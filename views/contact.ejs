<!-- Contact Form JavaScript -->

<script>

(function () {

    const form = document.getElementById("contactForm");
    const submitBtn = document.getElementById("submitBtn");
    const successMsg = document.getElementById("formSuccessMsg");


    if (!form || !submitBtn || !successMsg) {

        console.error("Contact form elements not found.");

        return;

    }


    form.addEventListener("submit", async function (e) {

        e.preventDefault();


        // Clear previous message
        successMsg.classList.remove("show", "error");
        successMsg.textContent = "";


        // Disable submit button
        submitBtn.classList.add("loading");
        submitBtn.disabled = true;


        /*
         * Convert FormData to URLSearchParams.
         *
         * This sends the form as:
         * application/x-www-form-urlencoded
         *
         * Express receives it through:
         * express.urlencoded({ extended: true })
         *
         * Therefore:
         *
         * dzOther[Phone]
         * dzOther[Subject]
         *
         * become:
         *
         * req.body.dzOther.Phone
         * req.body.dzOther.Subject
         */

        const formData = new URLSearchParams(
            new FormData(form)
        );


        try {

            const response = await fetch("/contact", {

                method: "POST",

                headers: {
                    "Content-Type":
                        "application/x-www-form-urlencoded"
                },

                body: formData

            });


            const responseText = await response.text();


            console.log(
                "Server status:",
                response.status
            );

            console.log(
                "Server response:",
                responseText
            );


            let result = null;


            try {

                result = JSON.parse(responseText);

            } catch (jsonError) {

                console.warn(
                    "Response is not JSON:",
                    responseText
                );

            }


            // ==============================
            // SUCCESS
            // ==============================

            if (
                response.ok &&
                result &&
                result.success === true
            ) {

                successMsg.classList.remove("error");

                successMsg.classList.add("show");

                successMsg.textContent =
                    "✅ Your form is submitted successfully!";


                // Clear form
                form.reset();

            }


            // ==============================
            // ERROR
            // ==============================

            else {

                let errorMessage =
                    "Something went wrong. Please try again.";


                if (result && result.message) {

                    errorMessage = result.message;

                }
                else if (result && result.error) {

                    errorMessage = result.error;

                }


                showError(errorMessage);

            }


        } catch (error) {

            console.error(
                "Fetch / Network error:",
                error
            );


            showError(
                "Unable to connect to server. Please try again."
            );

        }


        // Enable submit button
        submitBtn.classList.remove("loading");

        submitBtn.disabled = false;


        // Hide message after 10 seconds
        clearTimeout(window._formMsgTimer);


        window._formMsgTimer = setTimeout(function () {

            successMsg.classList.remove(
                "show",
                "error"
            );

            successMsg.textContent = "";

        }, 10000);

    });


    // ==============================
    // SHOW ERROR
    // ==============================

    function showError(message) {

        successMsg.classList.remove("show");

        successMsg.classList.add(
            "show",
            "error"
        );

        successMsg.textContent =
            "❌ " + message;

    }


})();

</script>


