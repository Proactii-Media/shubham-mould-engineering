<%- include('include/head') %>
    <%- include('include/header') %>

        <style>
            /* Make all service boxes equal height */
            .fly-box {
                height: 100%;
                display: flex;
                flex-direction: column;
            }

            .fly-box .dlab-media {
                flex-shrink: 0;
            }

            .fly-box .dlab-media img {
                width: 100%;
                height: 250px;
                object-fit: cover;
            }

            .fly-box .dlab-info {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .fly-box .dlab-info p {
                flex: 1;
            }
        </style>


        <!-- Content -->
        <div class="page-content bg-white">


            <!-- inner page banner -->
            <div class="dlab-bnr-inr  bg-pt" style="background-image:url(/shubhamimages/banner/service1.png);">
                <div class="container">
                    <div class="dlab-bnr-inr-entry">
                        <h1 class="text-white">Our Services</h1>
                        <!-- Breadcrumb row -->
                        <div class="breadcrumb-row">
                            <ul class="list-inline">
                                <li><a href="/">Home</a></li>
                                <li>Our Services</li>
                            </ul>
                        </div>
                        <!-- Breadcrumb row END -->
                    </div>
                </div>
            </div>
            <!-- inner page banner END -->

            <!-- inner page banner END -->
            <div class="bg-white">
                <div class="section-full bg-white content-inner">
                    <div class="container">
                        <div class="section-head style2 text-center">
                            <div class="sort-title clearfix text-center">
                                <h4 style="font-size: 24px;">Our Services</h4>
                                <p class="mt-3">At <strong> Shubham Mould & Engineering</strong>, we manufacture and
                                    export advanced industrial automation and machinery solutions for assembly,
                                    packaging, testing, counting, and moulding applications. Our machines help
                                    manufacturers improve production efficiency, precision, quality, and reduce manual
                                    operations with reliable automation solutions.

                                </p>
                            </div>

                        </div>

                        <div class="section-head style2 text-center">
                            <div class="sort-title clearfix text-center">
                                <h4 style="font-size: 24px;">Delivery Services</h4>
                            </div>
                        </div>
                        <div class="section-content p-b0">
                            <div class="row">
                                <% deliveryServices.forEach((item)=> { %>
                                    <div class="col-lg-4 col-md-6 col-sm-6 m-b30">
                                        <div class="icon-bx-wraper dlab-box fly-box">

                                            <div class="dlab-info p-a20 text-center bg-white">
                                                <div class="icon-bx-sm radius text-red border-2 m-b20"> <a
                                                        href="javascript:void(0);" class="icon-cell text-red"><i
                                                            class="<%= item.icon %>"></i> </div>

                                                <h4 class="m-a0 bg-primary content-box-head"><a
                                                        href="javascript:void(0);" class="text-white">
                                                        <%= item.title %>
                                                    </a></h4>
                                                <h5>
                                                    <%= item.subtitle %>
                                                </h5>
                                                <p class="m-b0">
                                                    <%= item.description %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>







                            </div>
                        </div>
                    </div>
                    <!-- Images box with content demo 1 END -->
                </div>

                <div class="section-full bg-white">
                    <div class="container">


                        <div class="section-head style2 text-center">
                            <div class="sort-title clearfix text-center">
                                <h4 style="font-size: 24px;">After Sales Services</h4>

                            </div>

                        </div>

                        <div class="section-content p-b0">
                            <div class="row">
                                <% afterSalesServices.forEach((item)=> { %>
                                    <div class="col-lg-4 col-md-6 col-sm-6 m-b30">
                                        <div class="dlab-box fly-box">

                                            <div class="icon-bx-wraper dlab-info p-a20 text-center bg-white">
                                                <div class="icon-bx-sm radius text-red border-2 m-b20"> <a
                                                        href="javascript:void(0);" class="icon-cell text-red"><i
                                                            class="<%= item.icon %>"></i> </div>


                                                <h4 class="m-a0 bg-primary content-box-head"><a
                                                        href="javascript:void(0);" class="text-white">
                                                        <%= item.title %>
                                                    </a></h4>
                                                <h5>
                                                    <%= item.subtitle %>
                                                </h5>
                                                <p class="m-b0">
                                                    <%= item.description %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                    </div>
                    <!-- Images box with content demo 1 END -->
                </div>
                <!-- Left & right section  END -->
            </div>
        </div>
        <!-- Content END-->
        <!-- Footer -->
        <%- include('include/footer') %>
            <!-- Footer End -->
            <button class="scroltop fas fa-chevron-up"></button>
            </div>
            <!-- JAVASCRIPT FILES ========================================= -->
            <script data-cfasync="false"
                src="../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
            <script src="js/jquery.min.js"></script><!-- JQUERY.MIN JS -->
            <script src="/plugins/wow/wow.js"></script><!-- WOW JS -->

            <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script><!-- BOOTSTRAP.MIN JS -->
            <script src="/plugins/bootstrap-select/bootstrap-select.min.js"></script><!-- FORM JS -->
            <script src="/plugins/bootstrap-touchspin/jquery.bootstrap-touchspin.js"></script><!-- FORM JS -->
            <script src="/plugins/magnific-popup/magnific-popup.js"></script><!-- MAGNIFIC POPUP JS -->
            <script src="/plugins/counter/waypoints-min.js"></script><!-- WAYPOINTS JS -->
            <script src="/plugins/counter/counterup.min.js"></script><!-- COUNTERUP JS -->
            <script src="/plugins/imagesloaded/imagesloaded.js"></script><!-- IMAGESLOADED -->
            <script src="/plugins/masonry/masonry-3.1.4.js"></script><!-- MASONRY -->
            <script src="/plugins/masonry/masonry.filter.js"></script><!-- MASONRY -->
            <script src="/plugins/owl-carousel/owl.carousel.js"></script><!-- OWL SLIDER -->
            <script src="/plugins/lightgallery/js/lightgallery-all.min.js"></script><!-- Lightgallery -->
            <script src="/plugins/scroll/scrollbar.min.js"></script><!-- scroll -->
            <script src="js/custom.js"></script><!-- CUSTOM FUCTIONS  -->
            <script src="js/dz.carousel.min.js"></script><!-- SORTCODE FUCTIONS  -->
            <script src="/plugins/countdown/jquery.countdown.js"></script><!-- COUNTDOWN FUCTIONS  -->
            <script src="js/dz.ajax.js"></script><!-- CONTACT JS  -->
            <script src="/plugins/rangeslider/rangeslider.js"></script><!-- Rangeslider -->
            <script src="/plugins/switcher/switcher.js"></script><!-- Switcher -->

            <script type="module"
                src="https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496"
                integrity="sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ=="
                data-cf-beacon='{"version":"2024.11.0","token":"0931814f84b94398b852d3ac91b5f293","r":1}'
                crossorigin="anonymous"></script>
            </body>

            </html>