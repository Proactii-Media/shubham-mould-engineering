<%- include('include/head') %>



    <%- include('include/header') %>

        <!-- header END -->
        <!-- Content -->
        <div class="page-content bg-white">
            <!-- inner page banner -->
            <div class="dlab-bnr-inr " style="background-image:url(/shubhamimages/banner/clientbanner.png);">
                <div class="container">
                    <div class="dlab-bnr-inr-entry">
                        <h1 class="text-white">Our Trusted Clients</h1>
                        <!-- Breadcrumb row -->
                        <div class="breadcrumb-row">
                            <ul class="list-inline">
                                <li><a href="/">Home</a></li>

                                <li>Our Trusted Clients</li>
                            </ul>
                        </div>
                        <!-- Breadcrumb row END -->
                    </div>
                </div>
            </div>

            <style>
                .client-logo-box {
                    width: 100%;
                    height: 220px;
                }

                .client-logo-media {
                    width: 100%;
                    height: 220px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    background: #fff;
                }

                .client-logo-media img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    padding: 25px;
                }

                .client-title h2 {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 25px;
                }

                .client-title h2::before,
                .client-title h2::after {
                    content: "";
                    height: 1px;
                    background: #ddd;
                    width: 120px;
                }

                .client-title h2 span {
                    white-space: nowrap;
                }
            </style>
            <!-- inner page banner END -->
            <div class="bg-gray lightgallery" id="lightgallery">
                <!-- Left & right section start -->
                <div class="section-full bg-gray content-inner">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="section-head style2 text-center">
                                    <h2 class="title m-b10">Our Awesome Clients</h2>

                                </div>
                                <!-- Images overlay on hover -->
                                <div class="section-content box-sort-in button-example p-b0">
                                    <div class="row">

                                        <% clientLogos.forEach((logo)=> { %>

                                            <div class="col-lg-3 col-md-6 col-sm-6 m-b15">
                                                <div class="dlab-box client-logo-box">


                                                    <div class="dlab-media dlab-img-overlay9 client-logo-media">
                                                        <img src="<%= logo.image %>" alt="Client Logo">
                                                    </div>


                                                </div>
                                            </div>

                                            <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Images overlay on hover END -->
                </div>
                <!-- Left & right section  END -->
            </div>
        </div>
        <!-- Left & right section END -->
        <!-- Content END-->
        <!-- Footer -->
        <%- include('include/footer') %>
            <!-- Footer End -->

            </div>

            <!-- JAVASCRIPT FILES ========================================= -->
            <!-- <script data-cfasync="false"
                src="../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script> -->
         
            </body>

            </html>