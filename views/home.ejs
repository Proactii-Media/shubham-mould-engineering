<!-- ✅ reCAPTCHA — MUST load AFTER the widget div is in the DOM -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("contactForm");
        const submitBtn = document.getElementById("submitBtn");
        const successMsg = document.getElementById("formSuccessMsg");

        if (!form) return;

        form.addEventListener("submit", async function (e) {

            e.preventDefault();

            // ✅ Guard: ensure reCAPTCHA is loaded
            if (typeof grecaptcha === "undefined") {
                successMsg.className = "form-success-message show error";
                successMsg.textContent = "❌ reCAPTCHA failed to load. Please refresh the page.";
                return;
            }

            // Check Google CAPTCHA
            const captchaResponse = grecaptcha.getResponse();

            console.log("CAPTCHA RESPONSE:", captchaResponse);

            if (!captchaResponse) {
                successMsg.className = "form-success-message show error";
                successMsg.textContent = "❌ Please complete the CAPTCHA.";
                return;
            }

            submitBtn.disabled = true;
            submitBtn.classList.add("loading");

            successMsg.className = "form-success-message";
            successMsg.textContent = "";

            try {

                const formData = new URLSearchParams();

                formData.append("dzToDo", "Contact");

                formData.append(
                    "dzName",
                    document.querySelector('[name="dzName"]').value
                );

                formData.append(
                    "dzEmail",
                    document.querySelector('[name="dzEmail"]').value
                );

                formData.append(
                    "dzOther[Phone]",
                    document.querySelector('[name="dzOther[Phone]"]').value
                );

                formData.append(
                    "dzOther[Subject]",
                    document.querySelector('[name="dzOther[Subject]"]').value
                );

                formData.append(
                    "dzMessage",
                    document.querySelector('[name="dzMessage"]').value
                );

                formData.append(
                    "g-recaptcha-response",
                    captchaResponse
                );

                const response = await fetch("/contact", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: formData.toString()
                });

                const result = await response.json();

                console.log("SERVER RESPONSE:", result);

                if (response.ok && result.success) {

                    successMsg.className = "form-success-message show";
                    successMsg.textContent = "✅ " + result.message;

                    form.reset();
                    grecaptcha.reset();

                } else {

                    successMsg.className = "form-success-message show error";
                    successMsg.textContent =
                        "❌ " + (result.message || "Something went wrong.");

                    grecaptcha.reset();
                }

            } catch (error) {

                console.error("CONTACT FORM ERROR:", error);

                successMsg.className = "form-success-message show error";
                successMsg.textContent =
                    "❌ Unable to submit the form. Please try again.";

                grecaptcha.reset();

            } finally {

                submitBtn.disabled = false;
                submitBtn.classList.remove("loading");

            }

        });

    });
</script>

<script>
    function equalServiceHeight() {

        let boxes = document.querySelectorAll(".service-box .icon-bx-wraper");

        let maxHeight = 0;

        boxes.forEach(box => {
            box.style.height = "auto";
        });

        boxes.forEach(box => {
            if (box.offsetHeight > maxHeight) {
                maxHeight = box.offsetHeight;
            }
        });

        boxes.forEach(box => {
            box.style.height = maxHeight + "px";
        });
    }

    window.addEventListener("load", equalServiceHeight);
    window.addEventListener("resize", equalServiceHeight);
</script>

