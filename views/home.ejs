            <!-- ============================================================ -->
            <!--   CORRECTED SCRIPT – REPLACES THE OLD FAULTY ONE              -->
            <!--   Keeps UI unchanged (uses class "current")                   -->
            <!-- ============================================================ -->
            <script>
                $(document).ready(function () {

                    var sync1 = $("#sync1");
                    var sync2 = $("#sync2");
                    var totalItems = sync1.find(".item").length;
                    var isSyncing = false;

                    // ---------- 1. MAIN CAROUSEL (loop: true) ----------
                    sync1.owlCarousel({
                        items: 1,
                        loop: true,
                        nav: true,
                        dots: false,
                        autoplay: true,
                        autoplayTimeout: 5000,
                        autoplayHoverPause: true,
                        smartSpeed: 600,
                        mouseDrag: true,
                        touchDrag: true,
                        navText: ['<i class="la la-angle-left"></i>', '<i class="la la-angle-right"></i>']
                    });

                    // ---------- 2. HEADINGS CAROUSEL (loop: false) ----------
                    sync2.owlCarousel({
                        items: 4,
                        loop: false,
                        nav: false,
                        dots: false,
                        margin: 20,
                        smartSpeed: 500,
                        mouseDrag: true,
                        touchDrag: true,
                        responsive: {
                            0: { items: 2 },
                            480: { items: 2 },
                            768: { items: 3 },
                            1024: { items: 4 },
                            1400: { items: 4 }
                        }
                    });

                    // ---------- 3. Helper: get real index (handles clones) ----------
                    function getRealIndex(event) {
                        if (typeof event.relatedTarget.relative === "function") {
                            return event.relatedTarget.relative(event.item.index);
                        }
                        return event.item.index;
                    }

                    // ---------- 4. Update headings (uses class "current") ----------
                    function updateHeadings(realIndex) {
                        var idx = realIndex % totalItems;
                        if (idx < 0) idx += totalItems;

                        sync2.find(".owl-item").removeClass("current");
                        sync2.find(".owl-item").eq(idx).addClass("current");
                        sync2.trigger("to.owl.carousel", [idx, 500, true]);
                    }

                    // ---------- 5. Sync: main → headings ----------
                    sync1.on("changed.owl.carousel", function (event) {
                        if (!event.namespace || isSyncing) return;
                        isSyncing = true;
                        var realIndex = getRealIndex(event);
                        updateHeadings(realIndex);
                        isSyncing = false;
                    });

                    // ---------- 6. Sync: click heading → main ----------
                    sync2.on("click", ".owl-item", function (e) {
                        e.preventDefault();
                        if (isSyncing) return;
                        isSyncing = true;

                        var clickedIndex = $(this).index(); // clean index because sync2 loop:false
                        sync1.trigger("to.owl.carousel", [clickedIndex, 600, true]);
                        updateHeadings(clickedIndex);

                        isSyncing = false;
                    });

                    // ---------- 7. Set first active on load ----------
                    setTimeout(function () {
                        updateHeadings(0);
                    }, 200);

                });
            </script>

