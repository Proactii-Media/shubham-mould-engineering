      <div class="mouse-circle"></div>

      <style>
        .mouse-circle {
          position: fixed;
          width: 20px;
          height: 20px;
          border: 0.25px solid #E80028;
          border-radius: 50%;
          background: transparent;
          pointer-events: none;
          z-index: 999999;
          transform: translate(-50%, -50%);
        }

        @media (max-width: 991px) {
          .mouse-circle {
            display: none;
          }
        }
      </style>

      <script>
        const mouseCircle = document.querySelector('.mouse-circle');

        let mouseX = 0;
        let mouseY = 0;
        let circleX = 0;
        let circleY = 0;

        document.addEventListener('mousemove', function (e) {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        function animateCircle() {
          circleX += (mouseX - circleX) * 0.12;
          circleY += (mouseY - circleY) * 0.12;

          mouseCircle.style.left = circleX + 'px';
          mouseCircle.style.top = circleY + 'px';

          requestAnimationFrame(animateCircle);
        }

        animateCircle();
      </script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          function equalInfoHeight() {
            const infos = document.querySelectorAll(".dez-info");
            infos.forEach(info => { info.style.height = "auto"; });
            let max = 0;
            infos.forEach(info => { if (info.offsetHeight > max) max = info.offsetHeight; });
            infos.forEach(info => { info.style.height = max + "px"; });
          }
          equalInfoHeight();
          window.addEventListener("resize", equalInfoHeight);
        });
      </script>
