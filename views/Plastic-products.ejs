<!DOCTYPE html>
<html lang="en">
<%- include('include/head') %>
<%- include('include/header') %>

<div class="page-content bg-white">
  <div class="dlab-bnr-inr overlay-black-middle bg-pt" style="background-image:url(/shubhamimages/banner/productbanner.png);">
    <div class="container">
      <div class="dlab-bnr-inr-entry">
        <h1 class="text-white">Plastic Products</h1>
        <div class="breadcrumb-row">
          <ul class="list-inline">
            <li><a href="/">Home</a></li>
            <li>Plastic Products</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="content-block">
    <div class="section-full content-inner-2 portfolio text-uppercase bg-gray" id="portfolio">
      <div class="container">
        <div class="site-filters clearfix center m-b40">
          <ul class="filters" data-bs-toggle="buttons">
            <li data-filter="" class="btn active">
              <input type="radio">
              <a href="javascript:void(0)" class="site-button-secondry button-sm radius-xl"><span>All</span></a>
            </li>
            <li data-filter="plastic-products" class="btn">
              <input type="radio">
              <a href="javascript:void(0)" class="site-button-secondry button-sm radius-xl"><span>Plastic Products</span></a>
            </li>
          </ul>
        </div>
        <div class="clearfix" id="lightgallery">
          <ul id="masonry" class="portfolio-ic dlab-gallery-listing gallery-grid-4 gallery row p-l0 sp10 lightgallery text-center">
            <% plasticproduct.forEach(product => { %>
            <li class="<%= product.category %> card-container col-lg-4 col-md-6 col-sm-6 p-a0">
              <div class="dlab-box dlab-gallery-box">
                <div class="dlab-media dlab-img-overlay1 dlab-img-effect">
                  <a href="<%= product.link %>"><img src="<%= product.image %>" alt="<%= product.title %>"></a>
                  <div class="overlay-bx">
                    <div class="overlay-icon">
                      <div class="text-white">
                        <a href="<%= product.link %>"><i class="fas fa-link icon-bx-xs"></i></a>
                        <span data-exthumbimage="<%= product.image %>" data-src="<%= product.image %>" class="check-km" title="<%= product.title %>"></span>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="dez-info p-a30 bg-white">
                  <p class="dez-title m-t0"><a href="<%= product.link %>"><%= product.title %></a></p>
                  <p ><small><%= product.type %></small></p>
                </div>
              </div>
            </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('include/footer') %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    function equalInfoHeight() {
      const infos = document.querySelectorAll(".dez-info");
      infos.forEach(info => { info.style.height = "auto"; });
      let max = 0;
      infos.forEach(info => { if (info.offsetHeight > max) max = info.offsetHeight; });
      infos.forEach(info => { info.style.height = max + "px"; });
    }
    equalInfoHeight();
    window.addEventListener("resize", equalInfoHeight);
  });
</script>
   <script src="js/jquery.min.js"></script>
            <script src="/plugins/wow/wow.js"></script>
           
            <script src="/plugins/bootstrap-select/bootstrap-select.min.js"></script>
