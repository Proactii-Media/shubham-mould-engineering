<style>
    @media (max-width: 991px) {

        #navbarNavDropdown .mobile-home-link,
        #navbarNavDropdown .mobile-contact-link {
            position: relative !important;
            z-index: 99999 !important;
            pointer-events: auto !important;
            cursor: pointer !important;
        }

    }
    .extra-nav {
        padding: 15px 0 8px 0px;
    }

    header.site-header {
        position: sticky;
        top: 0;
        z-index: 999;
        background: #fff;
    }

    .logo-header img,
    .logo-footer img {
        width: 62px !important;
        height: auto;
    }

    @media (max-width: 426px) {

        .logo-header img,
        .logo-footer img {
            margin-top: 2px;
            width: 52px !important;
            height: auto;
        }


        .site-header {
            min-height: 51px !important;
        }

    }
</style>

