<style>
  @media (max-width: 500px) {
    .filters2 ul.filters {
      display: flex !important;
      flex-wrap: wrap !important;
    }

    .filters2 ul.filters>li {
      width: 100% !important;
      max-width: 100% !important;
      flex: 0 0 100% !important;
      float: none !important;
      display: block !important;
    }
  }
</style>


<%- include('include/head') %>
  <%- include('include/header') %>
    <div class="page-content bg-white ">
      <div class="dlab-bnr-inr overlay-black-middle text-center bg-pt"
        style="background-image:url(/shubhamimages/banner/applicationbanner.png);">
        <div class="container ">
          <div class="dlab-bnr-inr-entry  align-m text-center">
            <h1 class="text-white">Applications</h1>
            <div class="breadcrumb-row">
              <ul class="list-inline ">
                <li><a href="/">Home</a></li>
                <li>Applications</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="content-block">
        <div class="page-content">
          <div class="section-full bg-white content-inner-2 wow fadeIn" data-wow-duration="2s" data-wow-delay="0.6s">
            <div class="container">
              <div class="section-head style2 text-center">
                <div class="sort-title clearfix text-center">
                  <h4 style="font-size: 24px;">Our Applications</h4>
                  <p class="mt-3">Our automatic machines are widely used across various industries including Pen &
                    Stationery,
                    Pharmaceutical, Packaging, and Engineering sectors. We provide advanced automation solutions
                    designed
                    to improve production efficiency, accuracy, and product quality with reliable performance.</p>
                </div>

              </div>
              <div class="row">
                <div class="site-filters m-b20 filters2">
                  <ul class="filters row" data-bs-toggle="buttons">

                    <li data-filter="" class="btn active col-12 col-md-4 col-lg-3">
                      <input type="radio">
                      <a href="javascript:void(0)">
                        <span>All</span>
                      </a>
                    </li>

                    <% applications.forEach(application=> { %>

                      <li data-filter="<%= application.slug %>" class="btn col-12 col-md-4 col-lg-3">

                        <input type="radio">

                        <a href="javascript:void(0)">
                          <span>
                            <%= application.shortTitle || application.title %>
                          </span>
                        </a>

                      </li>

                      <% }) %>

                  </ul>
                </div>
              </div>



              <div class="row p-l0 sp10">
                <div class="col-lg-12">
                  <ul id="masonry" class="dlab-gallery-listing gallery mfp-gallery text-center">
                    <% applications.forEach(application=> { %>
                      <li class="card-container col-lg-4 col-md-6 col-sm-6 <%= application.slug %>">
                        <div class="dlab-media dlab-img-overlay1 dlab-img-effect portbox3">
                          <img src="<%= application.image %>" alt="<%= application.title %>">
                          <div class="overlay-bx">
                            <div class="portinner">
                              <div class="port-up">
                                <span class="text-primary">APPLICATION</span>
                                <h3 class="port-title">
                                  <a href="javascript:void(0)" class="application-select"
                                    data-slug="<%= application.slug %>">
                                    <%= application.title %>
                                  </a>
                                </h3>
                              </div>
                              <div class="port-down">
                                <a href="javascript:void(0)" class="btn-link application-select"
                                  data-slug="<%= application.slug %>">View Detail <i class="la la-arrow-right"></i></a>
                              </div>
                            </div>
                          </div>
                        </div>
                      </li>
                      <% }) %>
                  </ul>
                  <div id="application-detail" class="application-detail-section" style="display:none;">
                    <% applications.forEach(application=> { %>
                      <div class="application-detail" id="detail-<%= application.slug %>" style="display:none;">
                        <div class="row align-items-center">
                          <div class="col-lg-6 col-md-6 m-b30">
                            <div class="application-detail-image">
                              <img src="<%= application.image %>" alt="<%= application.title %>" class="img-fluid">
                            </div>
                          </div>
                          <div class="col-lg-6 col-md-6 m-b30">
                            <div class="application-detail-content">
                              <span class="text-primary">APPLICATION</span>
                              <h2 class="m-b20">
                                <%= application.title %>
                              </h2>
                              <p style="text-align: justify;">
                                <%- application.description %>
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('include/footer') %>

  
      <script>
        document.addEventListener("DOMContentLoaded", function () { function equalImageHeight() { let images = document.querySelectorAll(".portbox3 img"); let maxHeight = 0; images.forEach(img => { img.style.height = "auto" }); images.forEach(img => { if (img.clientHeight > maxHeight) maxHeight = img.clientHeight }); images.forEach(img => { img.style.height = maxHeight + "px"; img.style.objectFit = "cover"; img.style.width = "100%" }) } window.addEventListener("load", equalImageHeight); window.addEventListener("resize", equalImageHeight) });
      </script>
      <script>
        $(document).ready(function () { $('.filters li[data-filter=""]').on('click', function () { $('#masonry').show(); $('#application-detail').hide(); $('.application-detail').hide() }); $('.filters li[data-filter!=""]').on('click', function () { let slug = $(this).attr('data-filter'); $('#masonry').hide(); $('#application-detail').show(); $('.application-detail').hide(); $('#detail-' + slug).fadeIn() }); $('.application-select').on('click', function () { let slug = $(this).data('slug'); $('#masonry').hide(); $('#application-detail').show(); $('.application-detail').hide(); $('#detail-' + slug).fadeIn(); $('html, body').animate({ scrollTop: $('#application-detail').offset().top - 100 }, 500) }) });
      </script>
      <script>$(document).ready(function () { new WOW().init() });</script>
      </body>

      </html>