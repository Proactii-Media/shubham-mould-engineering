<%- include('include/head') %>

    <style>
        strong {
            font-weight: 700 !important;
        }

        .about-box {
            padding: 10px;
            border: 2px dashed #E80028;
            border-radius: 20px;
            display: inline-block;
        }

        .about-box img {
            display: block;
            border-radius: 10px;
        }

        .application-banner {
    position: relative;
}

.application-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1); /* medium */
}

.application-banner .container {
    position: relative;
    z-index: 2;
}


.application-detail-section {
    margin-top: 40px;
}

.application-detail {
    padding: 30px;
    background: #fff;
}

.application-detail-image {
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
}

.application-detail-image img {
    width: 100%;
    height: 450px;
    object-fit: fill;
    display: block;
}

.application-detail-content {
    padding: 20px 30px;
}

.application-detail-content h2 {
    font-size: 32px;
    font-weight: 600;
    line-height: 1.3;
}

.application-detail-content p {
    font-size: 16px;
    line-height: 1.8;
    color: #666;
}

@media (max-width: 767px) {

    .application-detail {
        padding: 15px;
    }

    .application-detail-content {
        padding: 20px 5px;
    }

    .application-detail-content h2 {
        font-size: 25px;
    }

    .application-detail-image img {
        height: 300px;
    }
}
    </style>

