           <script>
$(document).ready(function () {

    // ALL APPLICATIONS
    $('.filters li[data-filter=""]').on('click', function () {

        // Show normal application cards
        $('#masonry').show();

        // Hide detail section
        $('#application-detail').hide();

        $('.application-detail').hide();

    });


    // APPLICATION FILTER BUTTON
    $('.filters li[data-filter!=""]').on('click', function () {

        let slug = $(this).attr('data-filter');

        // Hide normal cards
        $('#masonry').hide();

        // Show detail container
        $('#application-detail').show();

        // Hide all application details
        $('.application-detail').hide();

        // Show selected application
        $('#detail-' + slug).fadeIn();

    });


    // CLICK APPLICATION CARD / VIEW DETAIL
    $('.application-select').on('click', function () {

        let slug = $(this).data('slug');

        // Hide normal cards
        $('#masonry').hide();

        // Show detail container
        $('#application-detail').show();

        // Hide all details
        $('.application-detail').hide();

        // Show selected detail
        $('#detail-' + slug).fadeIn();

        // Scroll to detail
        $('html, body').animate({
            scrollTop: $('#application-detail').offset().top - 100
        }, 500);

    });

});
</script>



